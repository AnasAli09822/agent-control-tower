# Vercel server-only proxy targets. Never expose these through NEXT_PUBLIC_.
CONTROL_API_URL=https://<branch>-actcontrol.compute.<cell>.us-east-2.aws.neon.tech/
CONTROL_API_KEY=replace-with-long-random-secret
EVENTS_API_URL=https://<branch>-actevents.compute.<cell>.us-east-2.aws.neon.tech/
# Optional separate HMAC key for browser SSE tokens. If omitted, CONTROL_API_KEY is used.
EVENT_STREAM_SECRET=replace-with-long-random-secret
# Public demo scope enforced by server routes.
DEMO_WORKSPACE_ID=ws_demo
DEMO_OPERATOR_ID=operator_demo
